---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { groupPostsByYear } from '../../lib/posts';
import '../../styles/content.css';

const allPosts = await getCollection('posts');
const publishedPosts = allPosts
  .filter(p => p.data.status === 'publish')
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .map(p => ({ slug: p.data.slug, title: p.data.title, date: p.data.date }));
const postsByYear = groupPostsByYear(publishedPosts);
---

<Layout title="Knowledge Base" showSidebar={true} showMobileSidebar={true} postsByYear={postsByYear} currentSlug="kb">
	<main class="w-full md:w-[720px] mx-auto">
    <div class="w-full px-4">
      <article class="flex-auto pt-4 pb-12">
        <header>
          <h1 class="text-4xl mb-4">📚 Knowledge Base</h1>
        </header>
        <div class="content">
          <p>A curated archive of my notes while learning.</p>
        </div>
        <ul class="list-outside mb-8">
          <li class="my-3">
            <a
              href="/kb/relational-database"
              class="font-medium text-md text-gray-700! border-b-2 border-green-300/0 hover:border-green-300 hover:text-green-400! post-link"
              title="Relational Database"
            >
              🗄️ Relational Database
            </a>
          </li>
        </ul>
      </article>
    </div>
  </main>
</Layout>

<style>
	.post-link {
    width: fit-content;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 1 !important;
    -webkit-box-orient: vertical !important;
  }
</style>